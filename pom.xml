<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.smartship</groupId>
    <artifactId>smartship-edge-core</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>smartship-edge-core</name>
    <description>Core engine for ship-side IoT collection, multi-protocol parsing, thread governance, per-ship routing and reliable MQTT uplink</description>

    <properties>
        <java.version>17</java.version>
        <jserialcomm.version>2.10.4</jserialcomm.version>
        <paho.mqtt.version>1.2.5</paho.mqtt.version>
        <lombok.version>1.18.34</lombok.version>
        <!-- P1-4 benchmark 可配置参数（均有保守默认值，CLI -D 可覆盖） -->
        <benchmark.durationSeconds>5</benchmark.durationSeconds>
        <benchmark.messages>3000</benchmark.messages>
        <benchmark.threads>32</benchmark.threads>
        <benchmark.persistence.tasks>200,800</benchmark.persistence.tasks>
        <benchmark.persistence.latencyMs>5,25</benchmark.persistence.latencyMs>
        <benchmark.ships>1,10,50</benchmark.ships>
        <benchmark.mqtt.rows>10000</benchmark.mqtt.rows>
        <benchmark.highconcurrency.tasks>10000</benchmark.highconcurrency.tasks>
        <benchmark.highconcurrency.latencyMs>1</benchmark.highconcurrency.latencyMs>
        <benchmark.highconcurrency.ships>50</benchmark.highconcurrency.ships>
        <benchmark.batch.rows>10000</benchmark.batch.rows>
        <benchmark.batch.size>500</benchmark.batch.size>
        <benchmark.batch.ships>50</benchmark.batch.ships>
        <benchmark.sustained.rows>10000</benchmark.sustained.rows>
        <benchmark.sustained.ratePerSec>2500</benchmark.sustained.ratePerSec>
        <benchmark.sustained.ships>50</benchmark.sustained.ships>
        <benchmark.sustained.batch>100</benchmark.sustained.batch>
        <benchmark.outage.rows>750000</benchmark.outage.rows>
        <benchmark.outage.pollBatch>10000</benchmark.outage.pollBatch>
        <benchmark.outage.failAfter>100000</benchmark.outage.failAfter>
        <benchmark.outage.warmupRows>5000</benchmark.outage.warmupRows>
    </properties>

    <dependencies>
        <!-- Spring Boot Web & JDBC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- MySQL Driver -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Serial Communication (RS232/RS422/USB) -->
        <dependency>
            <groupId>com.fazecast</groupId>
            <artifactId>jSerialComm</artifactId>
            <version>${jserialcomm.version}</version>
        </dependency>

        <!-- MQTT Client (Edge to Shore Uplink) -->
        <dependency>
            <groupId>org.eclipse.paho</groupId>
            <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
            <version>${paho.mqtt.version}</version>
        </dependency>

        <!-- Spring Boot Actuator & Micrometer Prometheus -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- In-memory H2 Database for Testing -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Test Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- JDK21 + Mockito inline mock maker 需自附着 ByteBuddy agent，
                         否则分叉测试 JVM 报 "Can not attach to current VM"；
                         无 JaCoCo 等其他 argLine 消费者，直接声明即可 -->
                    <argLine>-Djdk.attach.allowAttachSelf=true</argLine>
                    <!-- P1-4: *BenchmarkTest 默认不随普通测试执行 -->
                    <excludes>
                        <exclude>**/*BenchmarkTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.smartship.edge.EdgeCoreApplication</mainClass>
                    <!-- 跨仓 E2E 需要：主产物保持普通 library jar（岸仓测试域可直接依赖
                         真实 Edge 类），可运行包改名 -exec。部署/运行请改用
                         target/smartship-edge-core-1.0.0-exec.jar -->
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- P1-4: mvn test -Pbenchmark 仅运行 *BenchmarkTest，结果落盘 target/benchmark -->
    <profiles>
        <profile>
            <id>benchmark</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <argLine>-Djdk.attach.allowAttachSelf=true</argLine>
                            <excludes combine.self="override" />
                            <includes>
                                <include>**/*BenchmarkTest.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <benchmark.durationSeconds>${benchmark.durationSeconds}</benchmark.durationSeconds>
                                <benchmark.messages>${benchmark.messages}</benchmark.messages>
                                <benchmark.threads>${benchmark.threads}</benchmark.threads>
                                <benchmark.persistence.tasks>${benchmark.persistence.tasks}</benchmark.persistence.tasks>
                                <benchmark.persistence.latencyMs>${benchmark.persistence.latencyMs}</benchmark.persistence.latencyMs>
                                <benchmark.ships>${benchmark.ships}</benchmark.ships>
                                <benchmark.mqtt.rows>${benchmark.mqtt.rows}</benchmark.mqtt.rows>
                                <benchmark.highconcurrency.tasks>${benchmark.highconcurrency.tasks}</benchmark.highconcurrency.tasks>
                                <benchmark.highconcurrency.latencyMs>${benchmark.highconcurrency.latencyMs}</benchmark.highconcurrency.latencyMs>
                                <benchmark.highconcurrency.ships>${benchmark.highconcurrency.ships}</benchmark.highconcurrency.ships>
                                <benchmark.batch.rows>${benchmark.batch.rows}</benchmark.batch.rows>
                                <benchmark.batch.size>${benchmark.batch.size}</benchmark.batch.size>
                                <benchmark.batch.ships>${benchmark.batch.ships}</benchmark.batch.ships>
                                <benchmark.sustained.rows>${benchmark.sustained.rows}</benchmark.sustained.rows>
                                <benchmark.sustained.ratePerSec>${benchmark.sustained.ratePerSec}</benchmark.sustained.ratePerSec>
                                <benchmark.sustained.ships>${benchmark.sustained.ships}</benchmark.sustained.ships>
                                <benchmark.sustained.batch>${benchmark.sustained.batch}</benchmark.sustained.batch>
                                <benchmark.outage.rows>${benchmark.outage.rows}</benchmark.outage.rows>
                                <benchmark.outage.pollBatch>${benchmark.outage.pollBatch}</benchmark.outage.pollBatch>
                                <benchmark.outage.failAfter>${benchmark.outage.failAfter}</benchmark.outage.failAfter>
                                <benchmark.outage.warmupRows>${benchmark.outage.warmupRows}</benchmark.outage.warmupRows>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
